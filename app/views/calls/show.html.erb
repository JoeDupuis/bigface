<div class="call-screen" data-controller="call" data-call-call-id-value="<%= @call.id %>" data-call-role-value="<%= @call.caller == Current.session.user ? 'caller' : 'recipient' %>" data-call-user-id-value="<%= Current.session.user.id %>" data-action="pointermove->call#handleMouseMove pointerup->call#handleTap">
  <div class="remote" data-call-target="remoteContainer">
    <video data-call-target="remoteVideo" autoplay playsinline></video>
  </div>

  <div class="local">
    <video data-call-target="localVideo" autoplay muted playsinline></video>
  </div>

  <div class="controls" data-call-target="controls" data-action="click->call#resetHideTimer">
    <p data-call-target="status">
      <% if @call.ringing? && @call.caller == Current.session.user %>
        Calling <%= @call.recipient.name %>...
      <% elsif @call.active? %>
        Connected
      <% end %>
    </p>

    <div class="actions">
      <% if @call.caller == Current.session.user %>
        <button data-action="call#switchCamera" data-call-target="switchCameraButton" class="button -secondary hidden">Switch Camera</button>
        <button data-action="call#endCall" data-call-target="cancelButton" class="button -danger <%= 'hidden' unless @call.ringing? %>">Cancel</button>
        <button data-action="call#endCall" data-call-target="endCallButton" class="button -danger <%= 'hidden' if @call.ringing? %>">End Call</button>
      <% elsif @call.active? %>
        <button data-action="call#switchCamera" data-call-target="switchCameraButton" class="button -secondary hidden">Switch Camera</button>
        <button data-action="call#endCall" class="button -danger">End Call</button>
      <% end %>
    </div>
  </div>
</div>
