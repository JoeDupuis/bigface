<div class="main-content">
  <nav class="tab-nav">
    <%= link_to contacts_path, class: "tab" do %>
      Contacts
    <% end %>
    <%= link_to calls_path, class: "tab -active" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      Call History
      <% missed_count = Current.user.incoming_calls.missed.where("created_at > ?", 24.hours.ago).count %>
      <% if missed_count > 0 %>
        <span class="badge"><%= missed_count %></span>
      <% end %>
    <% end %>
  </nav>

  <% if @calls.any? %>
    <div class="call-history-list">
      <% @calls.each do |call| %>
        <% other_user = call.caller == Current.session.user ? call.recipient : call.caller %>
        <% is_outgoing = call.caller == Current.session.user %>
        <% is_missed = call.missed? %>

        <div class="call-history-item">
          <div class="user-avatar -sm -<%= avatar_color(other_user.name) %>">
            <%= avatar_initials(other_user.name) %>
          </div>

          <div class="info">
            <p class="name <%= '-missed' if is_missed %>"><%= other_user.name %></p>
            <p class="meta">
              <span class="icon -<%= is_missed ? 'missed' : (is_outgoing ? 'outgoing' : 'incoming') %>">
                <% if is_outgoing %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="21" y1="3" x2="14" y2="10"/>
                  </svg>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    <polyline points="15 10 21 10 21 4"/>
                    <line x1="14" y1="3" x2="21" y2="10"/>
                  </svg>
                <% end %>
              </span>
              <span><%= call.created_at.to_date == Date.today ? "Today, #{call.created_at.strftime('%l:%M %p').strip}" : call.created_at.strftime('%b %d') %></span>
              <% if call.ended? && call.started_at %>
                <span>&middot; <%= format_duration(call.ended_at - call.started_at) %></span>
              <% end %>
            </p>
          </div>

          <% if Contact.exists?(user: Current.user, contact: other_user) %>
            <%= button_to calls_path(call: { recipient_id: other_user.id }), method: :post, class: "callback", title: "Call back" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/>
                <rect x="2" y="6" width="14" height="12" rx="2"/>
              </svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <h3 class="title">No calls yet</h3>
      <p class="text">Your call history will appear here</p>
    </div>
  <% end %>
</div>
