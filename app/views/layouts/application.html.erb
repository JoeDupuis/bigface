<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bigface" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bigface">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-refresh-method" content="morph">

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= turbo_stream_from Current.user if Current.user %>

    <div id="flash-messages">
      <%= render "application/flash_messages" %>
    </div>

    <% if authenticated? && !content_for?(:skip_header) %>
      <header class="app-header">
        <%= link_to contacts_path, class: "brand" do %>
          <div class="logo">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/>
              <rect x="2" y="6" width="14" height="12" rx="2"/>
            </svg>
          </div>
          <span class="title">Bigface</span>
        <% end %>

        <div class="actions">
          <%= button_to session_path, method: :delete, class: "btn", title: "Logout" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          <% end %>
        </div>
      </header>
    <% end %>

    <%= yield %>

    <% auto_answer = params[:auto_answer].present? %>
    <% incoming_call = params[:incoming_call_id].present? ? Call.find_by(id: params[:incoming_call_id], status: :ringing) : Current.user&.incoming_calls&.ringing&.first %>
    <% if incoming_call %>
      <div class="incoming-call-overlay"
           data-controller="<%= 'auto-answer' if auto_answer %> bridge--call"
           id="incoming-call-overlay">
        <div class="content">
          <p class="callername"><%= "#{incoming_call.caller.name} is calling..." %></p>
          <div class="actions">
            <%= button_to "Answer", call_answer_path(incoming_call), class: "button -answer", data: { turbo: false, auto_answer_target: "answerButton" } %>
            <%= button_to "Decline", call_decline_path(incoming_call), class: "button -decline", data: { turbo: false, action: "click->bridge--call#decline" } %>
          </div>
        </div>
      </div>
    <% end %>

    <% if Rails.env.development? %>
      <div class="branch-indicator">
        <%= current_git_branch || "unknown" %>
      </div>
    <% end %>
  </body>
</html>
