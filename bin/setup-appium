#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

echo "Installing Appium and UiAutomator2 driver..."

npm install --save-dev appium
npx appium driver install uiautomator2

echo ""
echo "Appium setup complete!"
echo ""
echo "To run Android tests:"
echo "  1. Start an emulator or connect a device"
echo "  2. In one terminal: npx appium"
echo "  3. In another terminal: bin/rails android:test:run"
