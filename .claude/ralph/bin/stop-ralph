#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
LOOP_CONTROL="$PROJECT_DIR/.claude/ralph/loop-control"

if [ -f "$LOOP_CONTROL" ]; then
    rm "$LOOP_CONTROL"
    echo "Stop signal sent. Loop will exit after current session ends."
else
    echo "Loop is not running (no loop-control file found)."
fi
