#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
LOOP_CONTROL="$PROJECT_DIR/.claude/ralph/loop-control"

echo "ralph" > "$LOOP_CONTROL"

export RALPH_WIGGUM_LOOP=true
export CLAUDE_PROJECT_DIR="$PROJECT_DIR"

echo "Starting Ralph Wiggum loop..."
echo "Run 'scripts/stop-ralph' from another terminal to stop after current session."
echo ""

while [ -f "$LOOP_CONTROL" ]; do
    echo "=== Starting new Claude session ==="
    cd "$PROJECT_DIR"
    claude --prompt-file .claude/ralph/prompt.md || true
    echo "=== Session ended ==="
    sleep 1
done

echo "Loop stopped."
